#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define Base   0
#define Extra  1
#define Tap    2
#define Button 3
#define Nav    4
#define Mouse  5
#define Media  6
#define Num    7
#define Sym    8
#define Fun    9

#define U_MT(MOD, TAP_KEY) &u_mt MOD TAP_KEY
#define U_LT(LAYER, TAP_KEY) &u_lt LAYER TAP_KEY

#define U_NP &none
#define U_NA &none
#define U_NU &none
#define U_BOOT &bootloader

#define U_RDO &kp K_AGAIN
#define U_PST &kp LS(INS)
#define U_CPY &kp LC(INS)
#define U_CUT &kp LS(DEL)
#define U_UND &kp K_UNDO

#define U_BTN1 &mkp MB1
#define U_BTN2 &mkp MB2
#define U_BTN3 &mkp MB3

#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define U_MS_U &mmv MOVE_UP
#define U_WH_D &msc SCRL_DOWN
#define U_WH_L &msc SCRL_LEFT
#define U_WH_R &msc SCRL_RIGHT
#define U_WH_U &msc SCRL_UP

#define TO_BASE &to Base
#define TO_EXTRA &to Extra
#define TO_TAP &to Tap
#define TO_BUTTON &to Button
#define TO_NAV &to Nav
#define TO_MOUSE &to Mouse
#define TO_MEDIA &to Media
#define TO_NUM &to Num
#define TO_SYM &to Sym
#define TO_FUN &to Fun

#define TOTEM_MIRYOKU( \
    K00, K01, K02, K03, K04,      K05, K06, K07, K08, K09, \
    K10, K11, K12, K13, K14,      K15, K16, K17, K18, K19, \
    K20, K21, K22, K23, K24,      K25, K26, K27, K28, K29, \
    N30, N31, K32, K33, K34,      K35, K36, K37, N38, N39 \
) \
    K00 K01 K02 K03 K04           K05 K06 K07 K08 K09 \
    K10 K11 K12 K13 K14           K15 K16 K17 K18 K19 \
    K00 K20 K21 K22 K23 K24       K25 K26 K27 K28 K29 K09 \
                K32 K33 K34       K35 K36 K37

/ {
    behaviors {
        u_mt: u_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        u_lt: u_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";
            bindings = <
                TOTEM_MIRYOKU(
                    &kp Q,             &kp W,             &kp E,             &kp R,             &kp T,             &kp Y,             &kp U,             &kp I,             &kp O,             &kp P,
                    U_MT(LGUI, A),     U_MT(LALT, S),     U_MT(LCTRL, D),    U_MT(LSHFT, F),    &kp G,             &kp H,             U_MT(LSHFT, J),    U_MT(LCTRL, K),    U_MT(LALT, L),     U_MT(LGUI, SQT),
                    U_LT(Button, Z),   U_MT(RALT, X),     &kp C,             &kp V,             &kp B,             &kp N,             &kp M,             &kp COMMA,         U_MT(RALT, DOT),   U_LT(Button, SLASH),
                    U_NP,              U_NP,              U_LT(Media, ESC),  U_LT(Nav, SPACE),  U_LT(Mouse, TAB), U_LT(Sym, RET),    U_LT(Num, BSPC),  U_LT(Fun, DEL),    U_NP,              U_NP
                )
            >;
        };

        extra_layer {
            label = "Extra";
            bindings = <
                TOTEM_MIRYOKU(
                    &kp Q,             &kp W,             &kp E,             &kp R,             &kp T,             &kp Y,             &kp U,             &kp I,             &kp O,             &kp P,
                    U_MT(LGUI, A),     U_MT(LALT, S),     U_MT(LCTRL, D),    U_MT(LSHFT, F),    &kp G,             &kp H,             U_MT(LSHFT, J),    U_MT(LCTRL, K),    U_MT(LALT, L),     U_MT(LGUI, SQT),
                    U_LT(Button, Z),   U_MT(RALT, X),     &kp C,             &kp V,             &kp B,             &kp N,             &kp M,             &kp COMMA,         U_MT(RALT, DOT),   U_LT(Button, SLASH),
                    U_NP,              U_NP,              U_LT(Media, ESC),  U_LT(Nav, SPACE),  U_LT(Mouse, TAB), U_LT(Sym, RET),    U_LT(Num, BSPC),  U_LT(Fun, DEL),    U_NP,              U_NP
                )
            >;
        };

        tap_layer {
            label = "Tap";
            bindings = <
                TOTEM_MIRYOKU(
                    &kp Q,             &kp W,             &kp E,             &kp R,             &kp T,             &kp Y,             &kp U,             &kp I,             &kp O,             &kp P,
                    &kp A,             &kp S,             &kp D,             &kp F,             &kp G,             &kp H,             &kp J,             &kp K,             &kp L,             &kp SQT,
                    &kp Z,             &kp X,             &kp C,             &kp V,             &kp B,             &kp N,             &kp M,             &kp COMMA,         &kp DOT,           &kp SLASH,
                    U_NP,              U_NP,              &kp ESC,           &kp SPACE,         &kp TAB,           &kp RET,           &kp BSPC,          &kp DEL,           U_NP,              U_NP
                )
            >;
        };

        button_layer {
            label = "Button";
            bindings = <
                TOTEM_MIRYOKU(
                    U_UND,             U_CUT,             U_CPY,             U_PST,             U_RDO,             U_RDO,             U_PST,             U_CPY,             U_CUT,             U_UND,
                    &kp LGUI,          &kp LALT,          &kp LCTRL,         &kp LSHFT,         U_NU,              U_NU,              &kp LSHFT,         &kp LCTRL,         &kp LALT,          &kp LGUI,
                    U_UND,             U_CUT,             U_CPY,             U_PST,             U_RDO,             U_RDO,             U_PST,             U_CPY,             U_CUT,             U_UND,
                    U_NP,              U_NP,              U_BTN3,            U_BTN1,            U_BTN2,            U_BTN2,            U_BTN1,            U_BTN3,            U_NP,              U_NP
                )
            >;
        };

        nav_layer {
            label = "Nav";
            bindings = <
                TOTEM_MIRYOKU(
                    U_BOOT,            TO_TAP,            TO_EXTRA,          TO_BASE,           U_NA,              U_RDO,             U_PST,             U_CPY,             U_CUT,             U_UND,
                    &kp LGUI,          &kp LALT,          &kp LCTRL,         &kp LSHFT,         U_NA,              &u_caps_word,      &kp LEFT,          &kp DOWN,          &kp UP,            &kp RIGHT,
                    U_NA,              &kp RALT,          TO_NUM,            TO_NAV,            U_NA,              &kp INS,           &kp HOME,          &kp PG_DN,         &kp PG_UP,         &kp END,
                    U_NP,              U_NP,              U_NA,              U_NA,              U_NA,              &kp RET,           &kp BSPC,          &kp DEL,           U_NP,              U_NP
                )
            >;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
                TOTEM_MIRYOKU(
                    U_BOOT,            TO_TAP,            TO_EXTRA,          TO_BASE,           U_NA,              U_RDO,             U_PST,             U_CPY,             U_CUT,             U_UND,
                    &kp LGUI,          &kp LALT,          &kp LCTRL,         &kp LSHFT,         U_NA,              U_NU,              U_MS_L,            U_MS_D,            U_MS_U,            U_MS_R,
                    U_NA,              &kp RALT,          TO_SYM,            TO_MOUSE,          U_NA,              U_NU,              U_WH_L,            U_WH_D,            U_WH_U,            U_WH_R,
                    U_NP,              U_NP,              U_NA,              U_NA,              U_NA,              U_BTN2,            U_BTN1,            U_BTN3,            U_NP,              U_NP
                )
            >;
        };

        media_layer {
            label = "Media";
            bindings = <
                TOTEM_MIRYOKU(
                    U_BOOT,            TO_TAP,            TO_EXTRA,          TO_BASE,           U_NA,              U_NA,              U_NA,              U_NA,              U_NA,              U_NA,
                    &kp LGUI,          &kp LALT,          &kp LCTRL,         &kp LSHFT,         U_NA,              &ext_power EP_TOG, &kp C_PREV,        &kp C_VOL_DN,      &kp C_VOL_UP,      &kp C_NEXT,
                    U_NA,              &kp RALT,          TO_FUN,            TO_MEDIA,          U_NA,              &out OUT_TOG,      &bt BT_SEL 0,      &bt BT_SEL 1,      &bt BT_SEL 2,      &bt BT_SEL 3,
                    U_NP,              U_NP,              U_NA,              U_NA,              U_NA,              &kp C_STOP,        &kp C_PP,          &kp C_MUTE,        U_NP,              U_NP
                )
            >;
        };

        num_layer {
            label = "Num";
            bindings = <
                TOTEM_MIRYOKU(
                    &kp LBKT,          &kp N7,            &kp N8,            &kp N9,            &kp RBKT,          U_NA,              TO_BASE,           TO_EXTRA,          TO_TAP,            U_BOOT,
                    &kp SEMI,          &kp N4,            &kp N5,            &kp N6,            &kp EQUAL,         U_NA,              &kp LSHFT,         &kp LCTRL,         &kp LALT,          &kp LGUI,
                    &kp GRAVE,         &kp N1,            &kp N2,            &kp N3,            &kp BSLH,          U_NA,              TO_NUM,            TO_NAV,            &kp RALT,          U_NA,
                    U_NP,              U_NP,              &kp DOT,           &kp N0,            &kp MINUS,         U_NA,              U_NA,              U_NA,              U_NP,              U_NP
                )
            >;
        };

        sym_layer {
            label = "Sym";
            bindings = <
                TOTEM_MIRYOKU(
                    &kp LBRC,          &kp AMPS,          &kp ASTRK,         &kp LPAR,          &kp RBRC,          U_NA,              TO_BASE,           TO_EXTRA,          TO_TAP,            U_BOOT,
                    &kp COLON,         &kp DLLR,          &kp PRCNT,         &kp CARET,         &kp PLUS,          U_NA,              &kp LSHFT,         &kp LCTRL,         &kp LALT,          &kp LGUI,
                    &kp TILDE,         &kp EXCL,          &kp AT,            &kp HASH,          &kp PIPE,          U_NA,              TO_SYM,            TO_MOUSE,          &kp RALT,          U_NA,
                    U_NP,              U_NP,              &kp LPAR,          &kp RPAR,          &kp UNDER,         U_NA,              U_NA,              U_NA,              U_NP,              U_NP
                )
            >;
        };

        fun_layer {
            label = "Fun";
            bindings = <
                TOTEM_MIRYOKU(
                    &kp F12,           &kp F7,            &kp F8,            &kp F9,            &kp PSCRN,         U_NA,              TO_BASE,           TO_EXTRA,          TO_TAP,            U_BOOT,
                    &kp F11,           &kp F4,            &kp F5,            &kp F6,            &kp SLCK,          U_NA,              &kp LSHFT,         &kp LCTRL,         &kp LALT,          &kp LGUI,
                    &kp F10,           &kp F1,            &kp F2,            &kp F3,            &kp PAUSE_BREAK,   U_NA,              TO_FUN,            TO_MEDIA,          &kp RALT,          U_NA,
                    U_NP,              U_NP,              &kp K_APP,         &kp SPACE,         &kp TAB,           U_NA,              U_NA,              U_NA,              U_NP,              U_NP
                )
            >;
        };
    };
};
