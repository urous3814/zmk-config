menu "TOTEM Customization"

config TOTEM_PROSPECTOR_BRIGHTNESS_DEFAULT
    int "Prospector default brightness"
    default 70
    range 0 100

config TOTEM_PROSPECTOR_BRIGHTNESS_STEP
    int "Prospector brightness step"
    default 10
    range 1 100

config TOTEM_PROSPECTOR_BRIGHTNESS_MIN
    int "Prospector minimum brightness"
    default 10
    range 0 100

config TOTEM_TELEMETRY
    bool "Enable Totem host telemetry"
    default n
    help
      Streams live layer and battery snapshots from the dongle to the host over
      a USB CDC ACM serial port.

config TOTEM_TELEMETRY_INTERVAL_MS
    int "Totem telemetry resend interval (ms)"
    default 5000
    range 250 60000
    depends on TOTEM_TELEMETRY

endmenu
