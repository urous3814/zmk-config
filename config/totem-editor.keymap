#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        u_mt: u_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        u_lt: u_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp P
                &u_mt LGUI A     &u_mt LALT S     &u_mt LCTRL D    &u_mt LSHFT F    &kp G            &kp H            &u_mt LSHFT J    &u_mt LCTRL K    &u_mt LALT L     &u_mt LGUI SQT
                &kp Q            &u_lt 3 Z        &u_mt RALT X     &kp C            &kp V            &kp B            &kp N            &kp M            &kp COMMA        &u_mt RALT DOT   &u_lt 3 SLASH    &kp P
                                  &u_lt 6 ESC      &u_lt 4 SPACE    &u_lt 5 TAB      &u_lt 8 RET      &u_lt 7 BSPC     &u_lt 9 DEL
            >;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
                &kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp P
                &u_mt LGUI A     &u_mt LALT S     &u_mt LCTRL D    &u_mt LSHFT F    &kp G            &kp H            &u_mt LSHFT J    &u_mt LCTRL K    &u_mt LALT L     &u_mt LGUI SQT
                &kp Q            &u_lt 3 Z        &u_mt RALT X     &kp C            &kp V            &kp B            &kp N            &kp M            &kp COMMA        &u_mt RALT DOT   &u_lt 3 SLASH    &kp P
                                  &u_lt 6 ESC      &u_lt 4 SPACE    &u_lt 5 TAB      &u_lt 8 RET      &u_lt 7 BSPC     &u_lt 9 DEL
            >;
        };

        tap_layer {
            display-name = "Tap";
            bindings = <
                &kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp P
                &kp A            &kp S            &kp D            &kp F            &kp G            &kp H            &kp J            &kp K            &kp L            &kp SQT
                &kp Q            &kp Z            &kp X            &kp C            &kp V            &kp B            &kp N            &kp M            &kp COMMA        &kp DOT          &kp SLASH        &kp P
                                  &kp ESC          &kp SPACE        &kp TAB          &kp RET          &kp BSPC         &kp DEL
            >;
        };

        button_layer {
            display-name = "Button";
            bindings = <
                &kp K_UNDO       &kp LS(DEL)      &kp LC(INS)      &kp LS(INS)      &kp K_AGAIN      &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO
                &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none            &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
                &kp K_UNDO       &kp LS(DEL)      &kp LC(INS)      &kp LS(INS)      &kp K_AGAIN      &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO       &kp K_UNDO       &kp K_UNDO
                                  &mkp MB3         &mkp MB1         &mkp MB2         &mkp MB2         &mkp MB1         &mkp MB3
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &bootloader      &to 2            &to 1            &to 0            &none            &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO
                &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none            &u_caps_word     &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT
                &bootloader      &kp RALT         &to 7            &to 4            &none            &kp INS          &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &kp END          &kp K_UNDO
                                  &kp RET          &kp BSPC         &kp DEL          &kp RET          &kp BSPC         &kp DEL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &bootloader      &to 2            &to 1            &to 0            &none            &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO
                &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none            &none            &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT
                &bootloader      &kp RALT         &to 8            &to 5            &none            &none            &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP     &msc SCRL_RIGHT  &msc SCRL_RIGHT  &kp K_UNDO
                                  &mkp MB2         &mkp MB1         &mkp MB3         &mkp MB2         &mkp MB1         &mkp MB3
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &bootloader      &to 2            &to 1            &to 0            &none            &none            &none            &none            &none            &none
                &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none            &ext_power EP_TOG &kp C_PREV      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT
                &bootloader      &kp RALT         &to 9            &to 6            &none            &out OUT_TOG     &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 3     &none
                                  &kp C_STOP       &kp C_PP         &kp C_MUTE       &kp C_STOP       &kp C_PP         &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                &kp LBKT         &kp N7           &kp N8           &kp N9           &kp RBKT         &none            &to 0            &to 1            &to 2            &bootloader
                &kp SEMI         &kp N4           &kp N5           &kp N6           &kp EQUAL        &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
                &kp LBKT         &kp GRAVE        &kp N1           &kp N2           &kp N3           &kp BSLH         &none            &to 7            &to 4            &kp RALT         &none            &bootloader
                                  &kp DOT          &kp N0           &kp MINUS        &kp DOT          &kp N0           &kp MINUS
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
                &kp LBRC         &kp AMPS         &kp ASTRK        &kp LPAR         &kp RBRC         &none            &to 0            &to 1            &to 2            &bootloader
                &kp COLON        &kp DLLR         &kp PRCNT        &kp CARET        &kp PLUS         &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
                &kp LBRC         &kp TILDE        &kp EXCL         &kp AT           &kp HASH         &kp PIPE         &none            &to 8            &to 5            &kp RALT         &none            &bootloader
                                  &kp LPAR         &kp RPAR         &kp UNDER        &kp LPAR         &kp RPAR         &kp UNDER
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
                &kp F12          &kp F7           &kp F8           &kp F9           &kp PSCRN        &none            &to 0            &to 1            &to 2            &bootloader
                &kp F11          &kp F4           &kp F5           &kp F6           &kp SLCK         &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
                &kp F12          &kp F10          &kp F1           &kp F2           &kp F3           &kp PAUSE_BREAK  &none            &to 9            &to 6            &kp RALT         &none            &bootloader
                                  &kp K_APP        &kp SPACE        &kp TAB          &kp K_APP        &kp SPACE        &kp TAB
            >;
        };
    };
};
